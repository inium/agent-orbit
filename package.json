{
  "name": "agent-orbit",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,json,html,css,scss,sass,less,md,mdx,yaml,yml,toml,svg}": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10"
  }
}
